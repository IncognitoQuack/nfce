# Copy to .env and fill in. Never commit or share .env.

# upstox = live data; mock = read MOCK_CHAIN_FILE (offline demo)
PROVIDER=upstox
# MOCK_CHAIN_FILE=data/sample_nifty_chain.json

# From the Upstox developer portal (Apps -> your app). Redirect URL must be registered exactly like this.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/callback

# Telegram: create a bot with @BotFather, send it any message, then get your chat id from
# https://api.telegram.org/bot<token>/getUpdates  ("chat":{"id": ...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Long random string. The TradingView webhook URL must end with ?key=<this value>
WEBHOOK_SECRET=

# Optional
# Telegram user ids (comma-separated) allowed besides TELEGRAM_CHAT_ID; private chats only
# TELEGRAM_ALLOWED_USER_IDS=
# QUOTE_SECONDS=15
# POLL_SECONDS=60
# PCR_DOI_VETO and ATM_WINDOW are frozen by REGISTRY.md (R3): changing them restarts that experiment
# POLL_UNDERLYINGS=NIFTY,BANKNIFTY
# ATM_WINDOW=5
# PCR_DOI_VETO=0.7
# DB_PATH=data/nfce.db

# Signals computed by the bridge itself from Upstox futures candles (no paid TradingView needed),
# the F&O stock scanner (10:15, 11:15, 13:15) and 1-ITM option legs for every signal.
POLL_UNDERLYINGS=NIFTY,SENSEX
ENGINE_UNDERLYINGS=NIFTY,SENSEX
ENGINE_TIMEFRAMES=3,5,15
SCANNER=on
STOCK_ENGINE=on
OPTION_LEGS=on
# Optional: your other private chats with the bot (comma-separated chat ids)
# TELEGRAM_EXTRA_CHAT_IDS=
# Optional paper ACCOUNT: starting capital (0 = off), risk per trade %, daily loss limit %, max open positions
# ACCOUNT_CAPITAL=200000
# ACCOUNTS=2L:200000,5L:500000   (several accounts: name:capital[:strategy])
#   strategies: base | concentrated | wide | confirm | cluster (evidence/strategy_accounts_protocol.md);
#   the first account sends messages, the others are quiet and shown side by side in /account
# SCANNER_MODE=watchlist   (or trade: paper-trade the scanner picks in the scanner book, outside the accounts)
# ACCOUNT_RISK_PCT=1.0
# ACCOUNT_DAILY_LOSS_PCT=3.0
# ACCOUNT_MAX_OPEN=4
